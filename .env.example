DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flexsignage
PORT=3001

# Signing secret for login JWTs — use a long random string in real
# environments. There is no fallback default; the app refuses to boot
# without this set.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Bootstrap admin account, created automatically on first boot if no admin
# user exists yet. Safe to leave set afterward — it's a no-op once an
# admin exists. Provide at least one of ADMIN_PHONE / ADMIN_EMAIL.
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
